<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Qtoxide.ViewModels"
        xmlns:views="using:Qtoxide.Views"
        x:Class="Qtoxide.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/qtoxide.ico">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:MainViewModel">
            <views:MainView />
        </DataTemplate>
    </Window.DataTemplates>
    <ContentControl Content="{Binding Current}" />
</Window>
